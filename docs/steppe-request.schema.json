{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAIRN Steppe Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "seed",
    "attempt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
